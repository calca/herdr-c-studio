{
  "id": "root",
  "type": "column",
  "children": [
    {
      "id": "tabs",
      "type": "block",
      "content": {
        "mod": "c-studio-tabs"
      },
      "size": {
        "px": 48
      },
      "window_drag": true
    },
    {
      "id": "work-body",
      "type": "row",
      "children": [
        {
          "id": "sidebar",
          "type": "column",
          "children": [
            {
              "id": "dock-docked",
              "type": "block",
              "content": {
                "mod": "c-studio-dock",
                "props": {
                  "docked": true
                }
              }
            }
          ],
          "size": {
            "px": 8
          },
          "min": 8,
          "max": 520,
          "resizable": false
        },
        {
          "id": "main",
          "type": "block",
          "content": {
            "tab": "active",
            "pane": {
              "header": {
                "content": {
                  "mod": "c-studio-pane"
                },
                "reveal": "always",
                "height": 36,
                "position": "top"
              },
              "border": {
                "width": 1,
                "color": "border"
              },
              "focus": {
                "width": 1,
                "color": "accent"
              },
              "radius": 14,
              "gap": 10,
              "lone": true,
              "veil": 0.35,
              "background": "surface"
            }
          }
        },
        {
          "id": "panel",
          "type": "column",
          "children": [
            {
              "id": "panel-body",
              "type": "stack",
              "children": [
                {
                  "id": "files",
                  "type": "block",
                  "content": {
                    "mod": "files"
                  }
                },
                {
                  "id": "changes",
                  "type": "block",
                  "content": {
                    "mod": "changes"
                  }
                }
              ],
              "active": "files"
            }
          ],
          "size": {
            "px": 360
          },
          "min": 280,
          "max": 700,
          "hidden": true,
          "background": "background",
          "border": {
            "width": 1,
            "color": "border"
          },
          "radius": 14
        }
      ],
      "padding": [
        10,
        10
      ],
      "gap": 10,
      "resizable": true,
      "floating": [
        {
          "id": "dock",
          "content": {
            "mod": "c-studio-dock"
          },
          "edge": "left",
          "align": "start",
          "peek": 52
        }
      ]
    },
    {
      "id": "status",
      "type": "block",
      "content": {
        "mod": "c-studio-status"
      },
      "size": {
        "px": 36
      }
    }
  ],
  "background": "canvas",
  "theme": {
    "light": "c-studio-light",
    "dark": "c-studio-dark"
  },
  "font": "SF Mono",
  "font_size": 14,
  "ui_font": "Geist",
  "terminal_padding": [
    16,
    14
  ],
  "resizable": false,
  "titlebar": "none",
  "traffic_lights": [
    18,
    22
  ],
  "link_handlers": [
    "c-studio-links"
  ],
  "toast": "c-studio-toast",
  "window_blur": true,
  "terminal_opacity": 0
}
